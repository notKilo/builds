{
  "name": "jsonshape",
  "version": "0.1.0",
  "description": "Infer a schema from JSON samples and emit TypeScript types or JSON Schema",
  "type": "module",
  "bin": { "jsonshape": "src/cli.ts" },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=22.18" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
